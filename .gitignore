# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime state
counter.json

# Autumn Towns build intermediates (the shipped overlay is data/autumn/overlay.zip)
/data/autumn/overlay/
/data/autumn/foliage/*.texture
# Winter Towns build intermediates (the shipped overlay is data/winter/overlay.zip)
/data/winter/overlay/
/data/winter/foliage/*.texture
/data/winter/assets/*.obj
__pycache__/

# Archipelago build output (apworld and client binaries)
/dist/
*.pyc

# Local Archipelago test rooms and the mod zips the client downloads while testing
/ap-test/
/seed*.zip
/seed*/

# Byte-identity baseline for verify-generate-mod-refactor.mjs: captured per refactor, stale after any pipeline or season change
/scripts/fixtures/zip-entry-hashes.json

# Built by scripts/build-apworld.mjs --public (the prebuild step). The companion app is
# the exception: scripts/publish-ap-client.mjs builds it and it is committed, because the
# site build has no Go.
/public/archipelago/*
!/public/archipelago/d2rr-ap.exe
